  {"id": "conv-ref-03", "category": "referent", "turns": ["posts about theft in Karimnagar", "What about that concept?"], "expect": {"status": "RESOLVED", "location": "Karimnagar", "concepts_include": ["theft"], "referents": [["concept", 1]], "note": "type matters: 'that concept' is theft, not the more salient Karimnagar"}},
