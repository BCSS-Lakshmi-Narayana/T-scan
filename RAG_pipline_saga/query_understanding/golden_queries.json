 ],
 "conversation_note": "Phase 1C conversation cases. `turns` are asked in order in one conversation; `expect` applies to the LAST turn. Fields are asserted only where listed. `author`/`final` name policy_contexts presets: the caller when the earlier turns were asked, and the caller at the last turn. Isolation cases create a conversation as `owner` and read it as `requester`; every foreign read must be indistinguishable from an unknown id.",
 "conversation_cases": [
  {"id": "conv-follow-01", "category": "follow_up", "turns": ["Show me incidents in Hyderabad.", "What about yesterday?"], "expect": {"status": "RESOLVED", "follow_up": true, "location": "Hyderabad", "time_kind": "yesterday", "concepts_include": ["incidents"], "context_used": [["location", "inherited"], ["time_range", "explicit"]]}},
