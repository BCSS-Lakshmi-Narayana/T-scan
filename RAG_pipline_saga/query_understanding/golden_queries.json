{
 "version": "1.0",
 "note": "Query Understanding golden set. Only fields listed for an entry are asserted, so an entry states what MUST be true and stays silent where several readings are defensible. 'intent_any' accepts more than one intent where the question genuinely supports it. This is a planning benchmark: no entry asserts an answer.",
 "tolerances": {
  "intent": "exact unless intent_any is given",
  "shape": "asserted only where the shape is the point of the case",
  "filters": "asserted values must be present; extra filters are allowed",
  "needs": "listed needs must be present; extra needs are allowed",
  "tools": "listed tools must be present and must exist in the registry",
  "time_kind": "exact",
  "location_text": "case-insensitive match, resolved must always be false",
  "min_ambiguities": "at least this many ambiguities must be flagged"
 },
 "queries": [
  {"id": "lookup-01", "query": "Show me posts about traffic police.",
   "intent_any": ["filtered_search", "lookup"], "needs": ["search"], "tools": ["hybrid_search"]},
  {"id": "lookup-02", "query": "Show the latest alerts", "intent_any": ["filtered_search", "lookup"],
   "filters": {"kind": "alert"}},
  {"id": "lookup-03", "query": "posts by @hydcitypolice", "filters": {"handle": "hydcitypolice"}},

  {"id": "filter-01", "query": "Show negative posts about traffic police.",
   "intent": "filtered_search", "shape": "filtered", "filters": {"sentiment": "negative"}},
  {"id": "filter-02", "query": "high risk alerts on facebook",
   "filters": {"risk_level": "high", "platform": "facebook", "kind": "alert"}},
  {"id": "filter-03", "query": "negative posts about corruption on x",
   "filters": {"sentiment": "negative", "topic": "corruption", "platform": "x"}},
  {"id": "filter-04", "query": "grievances tagging @TelanganaDGP",
   "filters": {"tagged": "TelanganaDGP", "kind": "grievance"}},

  {"id": "time-01", "query": "Show alerts from yesterday.", "time_kind": "yesterday"},
  {"id": "time-02", "query": "What happened in the last 7 days?", "time_kind": "last_n_days", "time_n": 7},
  {"id": "time-03", "query": "complaints this month", "time_kind": "this_month"},
  {"id": "time-04", "query": "alerts in the last 24 hours", "time_kind": "last_n_hours", "time_n": 24},
  {"id": "time-05", "query": "posts about corruption", "time_kind": "all_time"},

  {"id": "agg-01", "query": "How many complaints were received?", "intent": "aggregation",
   "shape": "analytical", "needs": ["aggregation"], "tools": ["aggregate"]},
  {"id": "agg-02", "query": "Which handles post the most negative content?",
   "intent": "aggregation", "group_by": ["handle"]},
  {"id": "agg-03", "query": "break down alerts by platform", "intent": "aggregation",
   "group_by": ["platform"]},
  {"id": "agg-04", "query": "how many high risk alerts yesterday", "intent": "aggregation",
   "time_kind": "yesterday", "filters": {"risk_level": "high"}},

  {"id": "trend-01", "query": "Are complaints increasing?", "intent": "trend_analysis",
   "shape": "trend", "needs": ["trend_analysis"], "tools": ["trend_analysis"]},
  {"id": "trend-02", "query": "is communal content rising in Karimnagar",
   "intent": "trend_analysis", "location_text": "karimnagar"},
  {"id": "trend-03", "query": "complaint trend over time", "intent": "trend_analysis"},

  {"id": "cmp-01", "query": "Compare Hyderabad and Cyberabad.", "intent": "comparison",
   "shape": "comparison", "needs": ["comparison"]},
  {"id": "cmp-02", "query": "compare this month with last month", "intent": "comparison"},

  {"id": "class-01", "query": "Which of these posts are communal and which are national?",
   "intent": "classification", "needs": ["classification"]},
  {"id": "class-02", "query": "classify these posts into local and national",
   "intent": "classification"},

  {"id": "situ-01", "query": "What's happening around police complaints in Hyderabad?",
   "intent": "situation_analysis", "shape": "ground_level", "location_text": "hyderabad",
   "needs": ["situation_analysis", "search"], "min_ambiguities": 1},
  {"id": "situ-02", "query": "What is happening on the ground regarding traffic issues?",
   "intent": "situation_analysis"},
  {"id": "situ-03", "query": "what is going on in Warangal", "intent": "situation_analysis",
   "shape": "ground_level", "location_text": "warangal"},

  {"id": "unk-01", "query": "What is this new term people are using?",
   "intent_any": ["unknown_concept", "situation_analysis"], "needs": ["concept_resolution"]},
  {"id": "unk-02", "query": "posts about ration card problems",
   "needs": ["concept_resolution"], "tools": ["unknown_concept_search"]},
  {"id": "unk-03", "query": "show me content about the new toll policy",
   "needs": ["concept_resolution"]},

  {"id": "deep-01", "query": "deep scan all posts for communal content",
   "intent": "deep_scan", "shape": "deep_scan", "tools": ["deep_scan"]},

  {"id": "multi-01", "query": "How many complaints are there, what are people saying, and which areas are affected?",
   "intent": "multi_part", "shape": "multi_part", "min_sub_questions": 2},
  {"id": "multi-02", "query": "How many alerts were raised in Karimnagar this week, and is it increasing?",
   "intent_any": ["multi_part", "trend_analysis", "aggregation"]},

  {"id": "follow-01", "query": "What about the previous week?", "intent": "follow_up",
   "shape": "follow_up", "min_referents": 1},
  {"id": "follow-02", "query": "and what about there?", "min_referents": 1},
  {"id": "follow-03", "query": "show me those alerts", "min_referents": 1},

  {"id": "amb-01", "query": "Show me police.", "min_ambiguities": 1},
  {"id": "amb-02", "query": "alerts in Hyderabad", "min_ambiguities": 1,
   "location_text": "hyderabad"},

  {"id": "ml-01", "query": "కరీంనగర్‌లో ఏం జరుగుతోంది", "valid": true},
  {"id": "ml-02", "query": "హైదరాబాద్‌లో పోలీసులపై ఫిర్యాదులు", "valid": true},
  {"id": "ml-03", "query": "हैदराबाद में क्या हो रहा है", "valid": true},
  {"id": "ml-04", "query": "पुलिस के खिलाफ शिकायतें", "valid": true},
  {"id": "ml-05", "query": "Karimnagar lo em jarugutondi", "valid": true},
  {"id": "ml-06", "query": "police station lo complaint ela cheyali", "valid": true},

  {"id": "none-01", "query": "xyzabc123", "degraded": true, "coverage": 0.0, "tools": []},
  {"id": "none-02", "query": "asdfgh", "intent_any": ["unknown_concept", "lookup", "filtered_search"],
   "note": "a lone alphabetic token is treated as a concept to resolve, not declared nonsense: telling a keyboard mash from an unusual proper noun needs a dictionary, and the honest outcome is a scan that finds nothing"},

  {"id": "chat-01", "query": "hi", "intent": "conversational", "shape": "conversational",
   "tools": []},
  {"id": "chat-02", "query": "what can you do?", "intent": "conversational"}
 ],
 "policy_note": "Phase 1B policy cases. Each names a caller context preset (see test_policy_golden.py) and asserts only the fields it lists: decision exactly; allowed/blocked as must-include sets; effective_districts exactly (null = unrestricted); reason codes as must-include. Plans come from the rules-only planner, so these also pin the Phase 1A -> 1B contract.",
 "policy_contexts": {
  "admin":        {"tenant_id": "tenant-alpha", "role": "admin", "districts": null, "permissions": []},
