# AI Assistant RAG pipeline — configuration.
# Copy to .env and fill in the blanks. Everything not listed here has a sane
# default in code; add a key only when you need to override it.

# --- MongoDB ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=test

# --- Generation: self-hosted vLLM (Qwen3-14B) ------------------------------
LLM_BASE_URL=http://<your-vllm-host>/v1
LLM_API_KEY=
LLM_MODEL=qwen3-14b
# The server advertises 16384, but it is shared and its usable capacity drops
# under other tenants' load. 8192 is the safe working budget; raise it if the
# box is dedicated.
LLM_MAX_CONTEXT=8192

# --- Embeddings: local Nomic model on this machine's GPU -------------------
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBED_DIM=768
# auto = use CUDA when available, else CPU. Batch 0 = size from detected VRAM.
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=0

# --- Background sync -------------------------------------------------------
INGEST_SCHEDULER_ENABLED=true
INGEST_INTERVAL_HOURS=8
# Collections the scheduler keeps in sync. Every cycle reads and hashes
# each document in this list, so trimming it to what you actually query
# is the main lever on cycle cost.
INGEST_COLLECTIONS=alerts,analyses,auditlogs,comments,contents,criticism_contacts,criticism_reports,dailyprogrammes,dial100incidents,engageranalyses,events,grievance_workflow_reports,grievances,grievancesources,instagramstories,keywords,legalsections,mastercalendarevents,ongoingevents,periscopeuploads,platformpolicies,pois,policymappings,query_reports,reports,reporttemplates,retweetrelationships,search_history,sources,suggestion_reports,telegramgroups,telegrammessages,temp_content,templates,twitteraccounts,users

# --- Retrieval scope -------------------------------------------------------
# Vector stores the chatbot may search. Must not be empty: an empty value
# overrides the code default and silently disables semantic search.
# 'contents' is excluded because 1.08M chunks take ~264s per brute-force query.
ALLOWED_QUERY_COLLECTIONS=alerts,grievances,events,dial100incidents,pois,keywords,sources,dailyprogrammes,telegrammessages,criticism_reports,grievance_workflow_reports,query_reports,suggestion_reports

# ── Multi-tenancy ────────────────────────────────────────────────────────────
# Each tenant owns a MongoDB database and its vectors are written into that
# same database. See MULTI_TENANCY.md.

# The control plane holding the tenant registry -- NOT a tenant database.
CONTROL_DB_NAME=saga-super-admin

# MUST be identical to backend/.env. If these drift, this service indexes a
# database the application never reads and every answer comes back empty.
TENANT_DB_PREFIX=police_tenant_

# The registry is shared with the political-state saga. This keeps the service
# to its own tenants: "police" here, "state" in a political deployment.
TENANT_TYPE=police

# How long a resolved tenant is cached before the registry is re-read.
TENANT_REGISTRY_TTL_S=300

# Warm vector stores held across all tenants. Each holds one collection's
# vectors in memory, so this is the retrieval memory ceiling.
RAG_MAX_WARM_STORES=24

# --- Service-to-service auth ---
# The backend must send this as x-api-key. Required whenever the service listens
# on anything other than 127.0.0.1. 32+ characters.
RAG_SERVICE_API_KEY=
# true = refuse to start if the key above is empty.
SERVICE_AUTH_REQUIRED=false
