# Copy to .env and adjust for your vLLM OpenAI-compatible host.
VLLM_BASE_URL=http://100.49.109.96/v1
VLLM_MODEL=Qwen3-14B-AWQ
VLLM_API_KEY=
VLLM_MAX_TOKENS=256
VLLM_TIMEOUT_S=90
VLLM_RETRIES=0
VLLM_CONCURRENCY=2
VLLM_GATE_SIZE=2
VLLM_CIRCUIT_FAILURES=8
VLLM_CIRCUIT_COOLDOWN_S=30
VLLM_TEMPERATURE=0
VLLM_JSON_SCHEMA=1
SENTIMENT_INTELLIGENCE_PROVIDER=vllm
SENTIMENT_INTELLIGENCE_MAX_TEXT_CHARS=4000

# --- Service-to-service auth ---
# The backend must send this as x-api-key. Required whenever the service listens
# on anything other than 127.0.0.1. 32+ characters.
SENTIMENT_SERVICE_API_KEY=
# true = refuse to start if the key above is empty.
SERVICE_AUTH_REQUIRED=false
