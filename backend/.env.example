MONGODB_URI=
 
# Control-plane database: the tenant registry, shared with the Super Admin and
# the other Saga products so there is ONE source of truth for tenants. Tenant
# DATA does not live here — it lives in this tenant's own database (see
# TENANT_DB_PREFIX below). Each saga's Tenant model scopes every query to the
# tenant types it owns, so this app only ever sees police tenants.
DB_NAME="saga-super-admin"
 
 
# Super Admin orchestrator's own database (same Atlas cluster, different db).
# Used to mirror tenants created here into saga_super_admin.tenants so they show
# up in the Super Admin dashboard too.
SUPER_ADMIN_MONGODB_URI=
 
CORS_ORIGINS=
PORT=8000
SUPER_ADMIN_SERVICE_KEY=
# Signs every access token. Was UNSET, which meant authController fell back
# to 'blura-hub-secret-key-change-in-production' — a string in the source, so
# anyone with the repo could mint an admin token for any tenant. Set
# separately from PLATFORM_SECRETS_KEY so rotating it leaves the stored
# BluGate credentials decryptable.
JWT_SECRET=

PLATFORM_SECRETS_KEY=


# Engine mode: set to 'true' when centralized engine handles content fetching
USE_ENGINE=false
ENGINE_TEMP_BATCH_SIZE=120
ENGINE_TEMP_CONCURRENCY=8
ENGINE_TEMP_POLL_MS=5000
ENGINE_TEMP_FAST_DRAIN=true
ENGINE_TEMP_PROCESSING_TIMEOUT_MS=900000
 

# ── Sentiment service (social_media_sentiment_analysis-multitennacy, vLLM) ──
# Hosted instance, shared with other apps (fair queue keyed by tenant_key)
SENTIMENT_SERVICE_URL=
SENTIMENT_SERVICE_TIMEOUT_MS=180000
SENTIMENT_MAX_CONCURRENCY=1
SENTIMENT_POLL_MS=30000
SENTIMENT_CLAIM_SIZE=20
SENTIMENT_MAX_ATTEMPTS=5
SENTIMENT_INTENT_MODE=free
# Service's intelligence text limit (SENTIMENT_INTELLIGENCE_MAX_TEXT_CHARS)
SENTIMENT_MAX_TEXT_CHARS=4000
# Matched keywords sent for the model's in-context check. 0 while the hosted service has
# Matches are still shown on alerts either way.
SENTIMENT_MAX_MATCHED_KEYWORDS=3
SENTIMENT_INTERACTIVE_BUDGET_MS=150000
INVESTIGATION_QUEUE_JOB_TIMEOUT_MS=180000
# Grievance source accounts per platform per tenant (Telangana runs ~46 FB pages, ~33 X handles)
GRIEVANCE_MAX_SOURCES_PER_PLATFORM=100



# LLM PROVIDERS
# Active LLM backend (currently only ollama is used in this setup)
PRIMARY_LLM_PROVIDER="ollama"
# Model name served by Ollama (heavier model = better quality but slower)
OLLAMA_MODEL="qwen2.5-7b-8k:latest"
# Ollama server endpoint
OLLAMA_BASE_URL=
# Per-request timeout in ms for Ollama API calls (headroom for first cold load after boot)
OLLAMA_TIMEOUT_MS=120000
# Hard cap for timeout in ms (prevents extremely high values)
OLLAMA_TIMEOUT_CAP_MS=120000
# Keep the model warm so it is NOT reloaded between calls. "30m" = stay loaded while
# monitoring is active, but allow a self-heal reload if it ever lands on CPU. (Avoid -1:
# it permanently pins the model wherever it FIRST loaded — if that was CPU, it never moves to GPU.)
OLLAMA_KEEP_ALIVE=30m
# Retry attempts per LLM request before marking failure
OLLAMA_MAX_ATTEMPTS=2
# Shared Ollama semaphore depth — how many analysis jobs this app keeps in flight at once
# (pipeline depth + fair FIFO across tenants).
# execution is capped separately by the Ollama server's OLLAMA_NUM_PARALLEL.
OLLAMA_MAX_CONCURRENCY=5
OLLAMA_CONCURRENCY=5
# Max queued requests before drop; 0 or negative = unlimited queue
OLLAMA_MAX_QUEUE_SIZE=0
# Max wait in queue (ms) before timing out; 0 = wait indefinitely
OLLAMA_QUEUE_WAIT_MS=0
# If true, reject quickly when queue is busy (lower latency, possible drops)
OLLAMA_ALLOW_FAST_FAIL=false
# Max input text length sent to LLM (longer text may increase latency)
OLLAMA_MAX_TEXT_LENGTH=1800
# Strict analysis mode toggle:
# true  => wait/retry until on-prem LLM reachable (no fallback alerting on LLM outage)
# false => proceed with fallback Normal analysis when LLM is unreachable/timeouts
ANALYSIS_STRICT_LLM_MODE=true
ENABLE_LLM_CATEGORIZATION=true
 

#blugate-base-url




# Facebook RapidAPI
RAPIDAPI_FACEBOOK_KEY=
RAPIDAPI_FACEBOOK_HOST="facebook-scraper3.p.rapidapi.com"
 
# # Instagram RapidAPI
RAPIDAPI_INSTAGRAM_KEYS=
RAPIDAPI_INSTAGRAM_HOST="ig-downloader-api.p.rapidapi.com"

#Twitter RapidAPI
RAPIDAPI_KEY=
RAPIDAPI_HOST="twitter241.p.rapidapi.com"
# YouTube API
YOUTUBE_API_KEY=
 

# # ML / Model Services (local)
# # Media Downloader Service (YT Videos & Twitter)
 
 
# #S3 bucket configuration for media storage
 
 
# # Telegram API (MTProto)
 
 
 
 
# # Maigret API Service
 
# # WhatsMyName API Service
 
 
 
 
# Default tenant for localhost development
DEFAULT_TENANT_SLUG=sharedreg-police
 
# Database-per-tenant naming. MUST differ from other sagas' prefix: tenant slugs
# are not unique across sagas, so a shared prefix would map two different
# tenants to one database.
TENANT_DB_PREFIX=police_tenant_
# shared     -> every tenant reads the database this process connects to (DB_NAME)
# per-tenant -> each tenant reads its own database, built at onboarding
# Set back to "shared" to roll back: the shared database still holds the originals.
TENANT_DB_MODE=per-tenant

# --- Content transport -----------------------------------------------------
# blugate  : every platform call goes through BluGate, which holds the tenant's
#            credentials and meters its quota. The default.
# rapidapi : the SAME upstream providers (twitter241, ig-downloader-api,
#            facebook-scraper3) called directly on one key below. Use this when
#            BluGate credentials are unavailable. Response shapes are identical,
#            so the parsers are unaffected. There is no per-tenant metering on
#            this path: one key serves every tenant.
CONTENT_PROVIDER=rapidapi

# Needed only when CONTENT_PROVIDER=rapidapi. One key covers X, Instagram and
# Facebook; a platform may override with RAPIDAPI_X_KEY etc.
# YouTube is Google's Data API v3, not RapidAPI, so it takes its own key.

# The Python RAG service. Stated explicitly: the code default is
# http://localhost:8100, while run.ps1 and the README use 8099, and a
# mismatch makes every assistant call fail with nothing in the UI to say why.
RAG_API_URL=

# --- Shared secrets for the AI services (must equal the values on the AI server) ---
# Generate each with: python3 -c "import secrets; print(secrets.token_hex(32))"
RAG_SERVICE_API_KEY=
SENTIMENT_SERVICE_API_KEY=
